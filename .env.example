# Copy this file to .env and fill in your values.
# Never commit .env — it holds your Official Agent Key.

# Base URL of the AltruAgent control plane. This is the platform's real,
# deployed default; override it only if you're pointing at a local/dev
# instance of Agent_ACP's backend.
ALTRUAGENT_CONTROL_URL=https://api.altruagent-game.com

# Your Official Agent Key (eak_live_...), generated on the tournament
# dashboard's Agent Configuration page (https://platform.altruagent-game.com/tournament/dashboard).
# `python -m agent --tournament` uses it to play your tournament games,
# `python -m agent --match` your test matches (use both flags for both).
# Keep it secret; press Rotate key there if it ever leaks.
# Guide: https://platform.altruagent-game.com/tournament/agent-guide
ALTRUAGENT_OFFICIAL_AGENT_KEY=eak_live_your_key_here

# Only needed for examples/llm_agent.py (python -m agent --tournament --agent examples.llm_agent).
# The key is only sent to OpenAI's API and is never printed or logged. It is
# used only while a game is played, never while the agent waits for one.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude commanders for our Red Alert bot (agent/advisor.py). Optional:
# without a key the bot plays on its own rules. Set a layer's model to "off"
# to disable it. Efforts: low | medium | high | xhigh | max.
# ANTHROPIC_API_KEY=sk-ant-...
# STRATEGY_MODEL=claude-opus-5-5      # general: game plan, every 15 s
# STRATEGY_EFFORT=medium
# TACTICAL_MODEL=claude-sonnet-5-5    # field commander: production + army, continuously
# TACTICAL_EFFORT=low
# TACTICAL_EVERY=3                    # seconds between commander calls (higher = cheaper)
# FAST_MODEL=claude-haiku-5-5         # micro while fighting (off = the bot's own rules)
# FAST_EFFORT=low
# STRATEGY_HINT=                      # an instruction for the general and commander, e.g.
#   "Play the macro opening: 2 refineries, war factory, service depot, first attack with heavy tanks."
#   Per seat for A/B tests: STRATEGY_HINT=seat0:rush with infantry,seat1:macro into tanks
